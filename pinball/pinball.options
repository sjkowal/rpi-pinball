# Comments are supported
DEVICE_HOSTNAME=pinball
# All variables will be translated to lower case and made available to hooks
device_user1=pinball
dEvIcE_UsER1pASs=CHANGE_ME_BEFORE_FLASHING
# Enable SSH so the device is reachable without a display attached
ssh_user1=y
# Variables set in the .cfg file can be overridden
IMAGE_NAME=pinball
