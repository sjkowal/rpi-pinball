# /etc/default/pinball-mpf -- settings for mpf.service (MPF at boot).
#
# mpf.service is enabled on every image but only runs MPF when autostart is
# switched on for the MPF project folder -- no maintenance mode or sudo needed:
#   pinball-autostart on       # creates <MPF project folder>/.autostart and starts MPF
#   pinball-autostart off      # removes it and stops MPF
#   pinball-autostart status
# For bench work without turning it off: `sudo systemctl stop mpf`.
#
# This file is on the read-only root: edit with `sudo pinball-rw`, then
# `sudo systemctl restart mpf` and `sudo pinball-ro`.

# MPF project folder. Empty means ~/mpf-project of the login user (UID 1000), which
# keeps working after Raspberry Pi Imager renames that user.
MPF_PROJECT_DIR=

# What to run:
#   auto  - `gmc-run` on MPF 0.80/0.81 images (import Godot assets,
#           then `cage -- mpf both`), `mpf both` on 0.57/0.58 images
#   both  - `mpf both`  (MPF + media controller)
#   game  - `mpf game`  (MPF core only, no media controller)
#   gmc   - `gmc-run`
MPF_MODE=auto

# -t  no ASCII text UI (a service has no terminal; the flag disables it)
# -P  production mode: waits for hardware on start, exits if startup fails
#     (systemd restarts it). It loads a prebuilt config bundle
#     (mpf_config.bundle, plus mpf_mc_config.bundle on 0.57/0.58) instead of the
#     YAML; pinball-mpf-launch builds it if missing. After changing the MPF
#     config, delete them: rm <MPF project folder>/*.bundle
# -A  don't write config cache files
MPF_ARGS="-t -P -A"

# Optional: device paths to wait for before starting MPF (space-separated),
# e.g. "/dev/serial/by-id/usb-...-if00". Use stable names, not ttyACM*.
WAIT_FOR_DEVICES=""
DEVICE_TIMEOUT=30

# MPF 0.80/0.81: the mouse pointer is hidden in the cage session. Set to 1 to
# show it.
#GMC_SHOW_CURSOR=1

# MPF 0.80/0.81: Godot's audio output buffer, in ms. `godot` (a wrapper)
# adds this unless the project sets audio/driver/output_latency itself.
# Default 60; Godot's own 15 ms default cracks on a Pi with ALSA. 0 = off.
#GMC_AUDIO_LATENCY=60

# Audio for MPF-MC (SDL), MPF 0.57/0.58. Card name from `aplay -l`. Leave unset to
# use the ALSA default device.
#SDL_AUDIODRIVER=alsa
#AUDIODEV=plughw:CARD=Device
