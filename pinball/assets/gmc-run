#!/bin/bash
# gmc-run -- run an MPF 0.80/0.81 machine with its Godot Media Controller (GMC)
# from source: import the Godot project's assets, then `mpf both` in cage.
#
#   gmc-run                       # MPF project folder = current directory
#   gmc-run ~/mpf-project         # explicit MPF project folder
#   gmc-run ~/mpf-project -X -v   # anything after the folder goes to `mpf both`
#   GMC_SKIP_IMPORT=1 gmc-run     # skip the import step
#   GMC_FORCE_IMPORT=1 gmc-run    # import even if nothing seems to have changed
#   GMC_SHOW_CURSOR=1 gmc-run     # keep the mouse pointer visible
#
# Why the import step is not optional: running a Godot project (which is
# what `mpf both` does -- it starts `godot` in the project folder) never
# imports assets; only the editor or `godot --headless --import` does. Until
# they are imported, every image, sound and font fails to load with "No
# loader found for resource". New or changed assets need it again, since a
# running project does not notice them. When nothing changed it takes a few
# seconds.
#
# Installed by the pinball-gmc layer (MPF 0.80/0.81 images only).
set -euo pipefail

die() { echo "gmc-run: $*" >&2; exit 1; }

MPF_PROJECT="."
if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
  MPF_PROJECT="$1"
  shift
fi
[ -d "$MPF_PROJECT" ] || die "MPF project folder '$MPF_PROJECT' does not exist"
# Run everything from the MPF project folder, so a relative gmc_project_path in
# gmc.cfg resolves the same way for the import below and for `mpf both`.
cd "$MPF_PROJECT"

# The Godot project is the MPF project folder itself, unless gmc.cfg's [cli]
# section points elsewhere (the same key `mpf both` reads). A -g on the
# command line is not looked at; use gmc.cfg for a separate project folder.
PROJECT="."
if [ -f gmc.cfg ]; then
  cfg="$(sed -n 's/^[[:space:]]*gmc_project_path[[:space:]]*[=:][[:space:]]*//p' gmc.cfg | head -n1)"
  cfg="${cfg%\"}"; cfg="${cfg#\"}"; cfg="${cfg%\'}"; cfg="${cfg#\'}"
  [ -z "$cfg" ] || PROJECT="$cfg"
fi
[ -f "$PROJECT/project.godot" ] || die "no project.godot in '$(cd "$PROJECT" 2>/dev/null && pwd || echo "$PROJECT")' -- is this an MPF project folder with a GMC (Godot) project?"

MPF="$(command -v mpf || echo /opt/mpf/venv/bin/mpf)"
[ -x "$MPF" ] || die "cannot find mpf (expected /opt/mpf/venv/bin/mpf)"

# Skip the import when nothing in the project changed since the last one:
# it starts headless Godot, which costs seconds at every boot. The stamp is
# written after a successful import -- Godot writes *.import files next to
# the assets while importing, and those must not count as changes. MPF's
# own runtime output in the project folder (logs/, data/, the production
# *.bundle files, the .autostart switch) is ignored too, or every run would
# trigger a re-import. Files copied in with their old timestamps kept (cp -p,
# rsync -t) aren't noticed: use GMC_FORCE_IMPORT=1 for those.
#
# A deletion only shows as a newer directory timestamp, and the project
# folder's own timestamp also changes whenever MPF creates logs/ or a
# bundle. So the stamp also records the top-level names (minus MPF's), and
# a different list counts as a change; deeper deletions are caught by their
# folder's timestamp.
STAMP="$PROJECT/.godot/pinball-import.stamp"
top_level() {
  (cd "$PROJECT" && ls -A1 | grep -v -x -E '\.godot|logs|data|\.git|\.autostart|.*\.bundle' || true)
}
project_changed() {
  [ -f "$STAMP" ] || return 0
  [ "$(top_level)" = "$(cat "$STAMP")" ] || return 0
  [ -n "$(find "$PROJECT" -mindepth 1 \
      \( -path "$PROJECT/.godot" -o -path "$PROJECT/logs" -o -path "$PROJECT/data" \
         -o -name .git -o -name .autostart -o -name '*.bundle' \) -prune \
      -o -newer "$STAMP" -print -quit)" ]
}

if [ -n "${GMC_SKIP_IMPORT:-}" ]; then
  :
elif [ -z "${GMC_FORCE_IMPORT:-}" ] && ! project_changed; then
  echo "gmc-run: no project changes since the last import; skipping it (GMC_FORCE_IMPORT=1 to force)"
else
  # On a fresh checkout (no .godot/ yet) the first import reports ~17
  # parse errors from GMC's editor plugin, which preloads its own icons
  # before they have been imported; a second pass is clean. So a fresh
  # project gets a silent first pass, and the pass that is shown is the one
  # whose errors are real. `--import` exits 0 even with errors (and even
  # for a corrupt image), so its output is the only signal.
  if [ ! -d "$PROJECT/.godot" ]; then
    echo "gmc-run: first import of this project (can take a while on a Pi)..."
    godot --headless --import --path "$PROJECT" > /dev/null 2>&1 || true
  fi
  echo "gmc-run: importing Godot assets..."
  godot --headless --import --path "$PROJECT" || die "godot --import failed"
  top_level > "$STAMP"
fi

# Already inside a graphical session (a desktop, or a cage started some
# other way): no need for a compositor of our own.
if [ -n "${WAYLAND_DISPLAY:-}" ] || [ -n "${DISPLAY:-}" ]; then
  exec "$MPF" both "$@"
fi
# Hide the mouse pointer: cage only hides it when no pointing device is
# plugged in. cage draws its own cursor from the theme named "default" and
# Godot from $XCURSOR_THEME or "default"; both search $XCURSOR_PATH, so
# pointing that at an all-transparent "default" theme (installed by
# pinball-gmc) hides it whichever of them draws it. Only for this cage
# session -- the system-wide cursor theme is untouched.
INVISIBLE_CURSORS=/usr/share/pinball/cursors-invisible
if [ -z "${GMC_SHOW_CURSOR:-}" ] && [ -d "$INVISIBLE_CURSORS/default" ]; then
  export XCURSOR_PATH="$INVISIBLE_CURSORS"
fi
exec cage -- "$MPF" both "$@"
