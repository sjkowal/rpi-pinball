#!/bin/bash

set -eu

# First-boot root filesystem auto-expand — adapted from
# jonnymacs/rpi-auto-resize-root (see docs/rpi-image-gen-notes.md for the
# full reference implementation this is based on). The root partition is
# built at 100% (zero free space — see ../config.options), so there's
# nowhere to `apt install`/`git clone` anything until this runs once.
#
# Delegates the partition-table resize to Raspberry Pi's own `raspi-config
# --expand-rootfs`: fdisk deletes+recreates the root partition at the same
# start sector with no explicit end (fills the disk). Device detection
# inside raspi-config itself is fully dynamic (findmnt/lsblk) — no hardcoded
# /dev/mmcblk0p2 assumptions, works on SD/USB/NVMe alike. Confirmed reliable
# on real hardware (verified via `fdisk -l` after the fact — partition table
# correctly grew from 1.7G to 14.5G).
#
# We do NOT rely on raspi-config's own resize2fs_once follow-up mechanism
# (an init.d script it self-registers to grow the filesystem on the next
# boot) — on real hardware that file came out empty (0 bytes) and never ran,
# for reasons not fully pinned down even after reproducing the exact
# heredoc-under-dash-no-tty write in isolation (which worked fine standalone
# — the failure is specific to raspi-config's actual runtime context). Doing
# our own `resize2fs` call after the reboot sidesteps that entirely: it's a
# single well-tested command with no dependency on raspi-config's internal
# scheduling, and a safe no-op if the filesystem already fills the partition
# — so it's fine to call unconditionally on every boot once the partition
# itself has already been resized.
chroot $1 apt install -y raspi-config fdisk

cat <<'EOF' > $1/usr/local/bin/expand-rootfs.sh
#!/bin/bash
# Deliberately no `set -e`: raspi-config's own comment says fdisk's exit
# code will likely be non-zero here (it can't reload a mounted partition
# table), and the trailing whiptail call inside do_expand_rootfs() has no
# TTY to render into under systemd — both are expected to "fail" without
# actually meaning failure. We need touch/sync/reboot to run regardless.
if [ ! -f /boot/firstboot_resized ]; then
    raspi-config --expand-rootfs
    touch /boot/firstboot_resized
    sync
    echo b > /proc/sysrq-trigger
else
    resize2fs "$(findmnt / -o source -n)"
fi
EOF
chroot $1 chmod +x /usr/local/bin/expand-rootfs.sh

cat <<'EOF' > $1/etc/systemd/system/expand-rootfs.service
[Unit]
Description=Expand root filesystem on first boot
After=local-fs.target
Before=getty.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/expand-rootfs.sh
RemainAfterExit=yes
User=root
Group=root

[Install]
WantedBy=multi-user.target
EOF
chroot $1 systemctl enable expand-rootfs
