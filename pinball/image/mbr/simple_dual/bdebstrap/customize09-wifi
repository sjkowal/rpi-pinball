#!/bin/bash

set -eu

# Credentials come from pinball/wifi-credentials.env, gitignored and never
# committed — copy it and fill in your own network before building. Absolute
# path matches where docker-compose.yml/build.sh mount the customizations dir
# inside the build container (see README.md).
. /home/imagegen/pinball/wifi-credentials.env

chroot $1 apt install -y firmware-brcm80211 wpasupplicant

mkdir -p $1/etc/wpa_supplicant
cat <<EOF > $1/etc/wpa_supplicant/wpa_supplicant-wlan0.conf
ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev
update_config=1

network={
    ssid="${WIFI_SSID}"
    psk="${WIFI_PSK}"
}
EOF
# No country= line above: without it wifi still works (world regulatory
# domain), just without the extended channel set your country may allow. Add
# country=<ISO 3166-1 alpha-2> here if you hit connectivity issues.
chroot $1 chmod 600 /etc/wpa_supplicant/wpa_supplicant-wlan0.conf

mkdir -p $1/etc/systemd/network
cat <<EOF > $1/etc/systemd/network/02-wlan0.network
[Match]
Name=wlan0

[Network]
DHCP=yes
EOF

chroot $1 systemctl enable wpa_supplicant@wlan0.service
