#!/bin/bash

set -eu

# MUST run after every other apt-installing customizeNN-* hook (hence the
# high number — keep it that way if you add new hooks). It replaces
# /etc/resolv.conf with a symlink that only resolves once systemd-resolved
# is actually running, which it isn't during the build (no init system in a
# chroot) — any apt install after this point in the same build would fail to
# resolve deb.debian.org/archive.raspberrypi.com.
#
# The rootfs's /etc/resolv.conf is left over from the Docker build container
# itself — debootstrap copies the build host's resolv.conf in so package
# downloads work during the build — and points at Docker's internal DNS
# (127.0.0.11), which doesn't exist once the image is flashed and booted on
# real hardware. That breaks all hostname resolution ("Temporary failure in
# name resolution") even though the network itself (IP/routing over
# eth0/wlan0) works fine. systemd-networkd's DHCP client alone can't
# populate /etc/resolv.conf from the DNS servers your router hands out —
# that hand-off is specifically systemd-resolved's job, and it isn't
# installed in the apt-min64 profile by default.
chroot $1 apt install -y systemd-resolved
chroot $1 systemctl enable systemd-resolved

# Force the correct end state ourselves rather than trust systemd-resolved's
# postinst to handle an already-present, foreign (Docker-injected) resolv.conf
# correctly — DHCP=yes implies UseDNS=yes by default on both eth0 and wlan0,
# so once resolved is actually running this stub gets the real DNS servers.
rm -f $1/etc/resolv.conf
ln -s /run/systemd/resolve/stub-resolv.conf $1/etc/resolv.conf
